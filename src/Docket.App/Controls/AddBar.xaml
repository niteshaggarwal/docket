<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Docket.App.Controls.AddBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="8">
        <!-- Above the bar: slash commands, search confirm, AI thinking and AI plan preview -->
        <Border x:Name="Panel" Visibility="Collapsed" CornerRadius="8" Padding="16,12"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1">
            <Grid>
                <!-- Slash command suggestions -->
                <StackPanel x:Name="SlashPanel" Spacing="2" Visibility="Collapsed">
                    <TextBlock Text="Commands" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,6" />
                    <ListView x:Name="SlashList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="SlashList_ItemClick" MaxHeight="260" />
                </StackPanel>

                <!-- Confirm a command that acts on search matches -->
                <Grid x:Name="ConfirmPanel" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="ConfirmIcon" Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="ConfirmTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" MaxHeight="180">
                        <StackPanel x:Name="ConfirmItems" Spacing="2" Margin="26,0,0,0" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="ConfirmCancel_Click" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource AccentButtonStyle}" Click="Confirm_Click" />
                    </StackPanel>
                </Grid>

                <!-- AI is thinking -->
                <Grid x:Name="ThinkingPanel" Visibility="Collapsed" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="ThinkingRing" Width="20" Height="20" IsActive="False" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ThinkingTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="ThinkingSub" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Cancel" Click="CancelAi_Click" VerticalAlignment="Center" />
                </Grid>

                <!-- AI plan preview -->
                <Grid x:Name="PlanPanel" Visibility="Collapsed" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16">
                            <Path Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="M12,1 C12.7,7.2 16.8,11.3 23,12 C16.8,12.7 12.7,16.8 12,23 C11.3,16.8 7.2,12.7 1,12 C7.2,11.3 11.3,7.2 12,1 Z" />
                        </Viewbox>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="PlanTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Untick anything you don't want. Nothing is added until you confirm." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PlanItems" Spacing="2" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Discard" Click="DiscardPlan_Click" />
                        <Button x:Name="AddPlanButton" Style="{StaticResource AccentButtonStyle}" Click="AddPlan_Click" />
                    </StackPanel>
                </Grid>

                <!-- A message (AI off, errors) -->
                <Grid x:Name="MessagePanel" Visibility="Collapsed" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="MessageIcon" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="6" Click="CloseMessage_Click" VerticalAlignment="Top"
                            AutomationProperties.Name="Close message" ToolTipService.ToolTip="Close">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- The bar itself -->
        <Grid x:Name="Bar" CornerRadius="8" MinHeight="52" Padding="6,0,6,0" ColumnSpacing="4"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlusButton" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="Submit_Click"
                    AutomationProperties.Name="Add task" ToolTipService.ToolTip="Add task (Enter)">
                <Grid>
                    <FontIcon x:Name="PlusIcon" Glyph="&#xE710;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <Viewbox x:Name="PlusSparkle" Width="16" Height="16" Visibility="Collapsed">
                        <Path Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="M12,1 C12.7,7.2 16.8,11.3 23,12 C16.8,12.7 12.7,16.8 12,23 C11.3,16.8 7.2,12.7 1,12 C7.2,11.3 11.3,7.2 12,1 Z" />
                    </Viewbox>
                </Grid>
            </Button>
            <TextBox x:Name="Box" Grid.Column="1" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Padding="6,8,6,8"
                     KeyDown="Box_KeyDown" PreviewKeyDown="Box_PreviewKeyDown" TextChanged="Box_TextChanged" AutomationProperties.Name="Add a task">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
            <Border x:Name="AiChip" Grid.Column="2" Visibility="Collapsed" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.95">
                <TextBlock x:Name="AiChipText" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <ToggleButton x:Name="AiToggle" Grid.Column="3" Width="36" Height="36" Padding="0" CornerRadius="4" VerticalAlignment="Center"
                          Click="AiToggle_Click" AutomationProperties.Name="Plan with AI" ToolTipService.ToolTip="Plan with AI">
                <Viewbox Width="16" Height="16">
                    <Path x:Name="AiGlyph" Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M12,1 C12.7,7.2 16.8,11.3 23,12 C16.8,12.7 12.7,16.8 12,23 C11.3,16.8 7.2,12.7 1,12 C7.2,11.3 11.3,7.2 12,1 Z" />
                </Viewbox>
            </ToggleButton>
        </Grid>
    </StackPanel>
</UserControl>
