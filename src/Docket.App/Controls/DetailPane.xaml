<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Docket.App.Controls.DetailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="12,8,12,2" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="16,16,16,8">
            <StackPanel Spacing="10" Padding="0,0,4,0">
                <!-- Title, parents, subtasks -->
                <Border Style="{StaticResource Card}" Padding="8">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="Breadcrumb" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,2,8,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="DoneBox" MinWidth="0" VerticalAlignment="Top" Margin="4,6,0,0" Click="Done_Click" AutomationProperties.Name="Mark as completed" />
                            <TextBox x:Name="TitleBox" Grid.Column="1" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                     LostFocus="Title_LostFocus" KeyDown="Title_KeyDown" AutomationProperties.Name="Title" />
                            <Button x:Name="StarButton" Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8" Click="Star_Click" AutomationProperties.Name="Mark as important" VerticalAlignment="Top">
                                <FontIcon x:Name="StarIcon" Glyph="&#xE734;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Button>
                        </Grid>

                        <TextBlock x:Name="SubtasksLabel" Text="Subtasks" Style="{StaticResource SectionLabel}" />
                        <StackPanel x:Name="SubtasksPanel" Spacing="0" />
                        <Grid ColumnSpacing="8" Margin="8,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBox x:Name="NewSubtaskBox" Grid.Column="1" PlaceholderText="Add subtask" BorderThickness="0" Background="Transparent" KeyDown="NewSubtask_KeyDown" AutomationProperties.Name="Add subtask" />
                        </Grid>

                        <!-- Parents: a task can sit under several -->
                        <TextBlock Text="Parents" Style="{StaticResource SectionLabel}" />
                        <StackPanel x:Name="ParentsPanel" Spacing="0" />
                        <HyperlinkButton x:Name="AddParentButton" Margin="4,0,0,2" Click="AddParent_Click" AutomationProperties.Name="Add parent">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock Text="Add parent…" /></StackPanel>
                        </HyperlinkButton>

                        <!-- Old checklist steps, from before subtasks -->
                        <StackPanel x:Name="StepsSection" Visibility="Collapsed" Spacing="2" Margin="0,4,0,0">
                            <Grid Margin="12,4,4,2">
                                <TextBlock Text="Checklist" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Padding="10,3" Click="ConvertSteps_Click" ToolTipService.ToolTip="Turn each checklist step into a real subtask" AutomationProperties.Name="Turn into subtasks">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8FD;" FontSize="12" /><TextBlock Text="Turn into subtasks" FontSize="12" /></StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="StepsPanel" Spacing="2" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- My Day -->
                <Border Style="{StaticResource Card}">
                    <Button x:Name="MyDayButton" Style="{StaticResource RowButton}" Click="MyDay_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon x:Name="MyDayIcon" Glyph="&#xE706;" FontSize="16" />
                            <TextBlock x:Name="MyDayText" Text="Add to My Day" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Reminder, due, repeat, start, end -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button x:Name="RemindButton" Style="{StaticResource RowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xEA8F;" FontSize="16" />
                                <StackPanel>
                                    <TextBlock x:Name="RemindText" Text="Remind me" />
                                    <TextBlock x:Name="RemindSub" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="RemindMenu" Opening="RemindMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="DueButton" Style="{StaticResource RowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE787;" FontSize="16" />
                                <TextBlock x:Name="DueText" Text="Add due date" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="DueMenu" Opening="DueMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource RowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8EE;" FontSize="16" />
                                <TextBlock x:Name="RepeatText" Text="Repeat" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="RepeatMenu" Opening="RepeatMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="12,2" />
                        <Button x:Name="StartButton" Style="{StaticResource RowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                                <TextBlock x:Name="StartText" Text="Add start date" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="StartMenu" Opening="StartMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="EndButton" Style="{StaticResource RowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7C1;" FontSize="16" />
                                <TextBlock x:Name="EndText" Text="Add end date" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="EndMenu" Opening="EndMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Priority and people -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button x:Name="PriorityButton" Style="{StaticResource RowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon x:Name="PriorityIcon" Glyph="&#xE8C9;" FontSize="16" />
                                <TextBlock x:Name="PriorityText" Text="Set priority" VerticalAlignment="Center" />
                                <ContentControl x:Name="PriorityBadge" IsTabStop="False" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="PriorityMenu" Opening="PriorityMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="12,2" />
                        <TextBlock Text="Assigned to" Style="{StaticResource SectionLabel}" />
                        <StackPanel x:Name="AssigneesPanel" Spacing="2" Padding="8,0,8,0" />
                        <Button x:Name="AssignButton" Style="{StaticResource RowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8FA;" FontSize="16" />
                                <TextBlock Text="Assign" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="AssignFlyout" Opening="AssignFlyout_Opening" Placement="Bottom">
                                    <StackPanel Width="280" Spacing="4">
                                        <TextBlock Text="Assign to" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                                        <StackPanel x:Name="PeoplePickPanel" Spacing="2" />
                                        <HyperlinkButton Content="Add people on the People page" Click="GoPeople_Click" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <InfoBar x:Name="AssignNote" IsOpen="False" IsClosable="True" Severity="Informational" Margin="8,0,8,8" />
                    </StackPanel>
                </Border>

                <!-- Categories, files -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Button x:Name="CategoryButton" Style="{StaticResource RowButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE8EC;" FontSize="16" />
                                <TextBlock x:Name="CategoryText" Text="Pick a category" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="CategoryFlyout" Opening="CategoryFlyout_Opening" Placement="Bottom">
                                    <StackPanel Width="260" Spacing="6">
                                        <StackPanel x:Name="CategoryPanel" Spacing="2" />
                                        <TextBox x:Name="NewCategoryBox" PlaceholderText="New category, press Enter" KeyDown="NewCategory_KeyDown" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <StackPanel x:Name="FilesPanel" Padding="12,0,12,0" Spacing="2" />
                        <Button Style="{StaticResource RowButton}" Click="AddFile_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE723;" FontSize="16" />
                                <TextBlock Text="Add file" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- List -->
                <Border Style="{StaticResource Card}" Padding="12,8">
                    <ComboBox x:Name="ListBox" Header="List" HorizontalAlignment="Stretch" DisplayMemberPath="Title" SelectionChanged="List_SelectionChanged" />
                </Border>

                <!-- Notes -->
                <TextBox x:Name="NotesBox" PlaceholderText="Add note" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" LostFocus="Notes_LostFocus" AutomationProperties.Name="Note" />

                <!-- History and comments -->
                <Border Style="{StaticResource Card}" Padding="12,10">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Activity" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="HistoryPanel" Spacing="6" />
                        <StackPanel x:Name="CommentsPanel" Spacing="8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Padding="8,6" ColumnSpacing="4" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Background="Transparent" BorderThickness="0" Click="Close_Click" ToolTipService.ToolTip="Hide details (Esc)" AutomationProperties.Name="Hide details">
                <FontIcon Glyph="&#xE89F;" FontSize="14" />
            </Button>
            <TextBlock x:Name="CreatedText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="Delete_Click" ToolTipService.ToolTip="Delete task" AutomationProperties.Name="Delete task">
                <FontIcon Glyph="&#xE74D;" FontSize="14" />
            </Button>
        </Grid>

        <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Top" />
    </Grid>
</UserControl>
