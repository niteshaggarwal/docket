<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Docket.App.Pages.BoardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Docket.App.Pages"
    xmlns:svc="using:Docket.App.Services">

    <Grid Padding="24,8,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,8,24,16">
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Drag cards between columns. Ticking a card moves it to Done." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" />
        </StackPanel>

        <ProgressRing x:Name="LoadingRing" Grid.Row="1" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" />
        <TextBlock x:Name="NoBoardText" Grid.Row="1" Visibility="Collapsed" Opacity="0.6" Margin="0,24,0,0"
                   Text="This project has no Kanban view. Add one in the browser, then press F5." />

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Columns">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,0,24,0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:BoardColumn">
                        <Grid Width="300" CornerRadius="8" Padding="8"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="6,4,6,8">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind CountText, Mode=OneWay}" Opacity="0.55" Style="{StaticResource BodyTextBlockStyle}" />
                            </StackPanel>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind Tasks}" Tag="{x:Bind}"
                                      SelectionMode="None" CanDragItems="True" AllowDrop="True" CanReorderItems="False"
                                      DragItemsStarting="Column_DragItemsStarting" DragOver="Column_DragOver" Drop="Column_Drop"
                                      MinHeight="120">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,3" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="svc:TaskItem">
                                        <Grid ColumnSpacing="8" Padding="10,8" CornerRadius="6"
                                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                                              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{x:Bind IsDone, Mode=OneWay}" Click="Done_Click" Tag="{x:Bind}" MinWidth="0" VerticalAlignment="Top" AutomationProperties.Name="Mark done" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind DueText, Mode=OneWay}" Visibility="{x:Bind HasDue, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                                    <TextBlock Text="{x:Bind PriorityText, Mode=OneWay}" Visibility="{x:Bind HasPriority, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
