<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Docket.App.Pages.PeoplePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="32,20,32,32" Spacing="16" MaxWidth="1040" HorizontalAlignment="Left">
            <StackPanel Spacing="2">
                <TextBlock Text="People and teams" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Everyone with an account on your Docket server that you work with. Assign them tasks and share lists with them."
                           Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Add a person -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8FA;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Add a person" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <RadioButtons x:Name="KindChoice" MaxColumns="2" SelectedIndex="0" SelectionChanged="Kind_Changed">
                        <x:String>With their email</x:String>
                        <x:String>Local person (no email)</x:String>
                    </RadioButtons>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox x:Name="NameBox" Header="Name" PlaceholderText="Jordan Lee" Width="220" TextChanged="Name_TextChanged" />
                        <TextBox x:Name="EmailBox" Header="Email" PlaceholderText="jordan@example.com" Width="260" TextChanged="Name_TextChanged" />
                        <TextBox x:Name="UserBox" Header="Username" PlaceholderText="jordan.lee" Width="180" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CreateButton" Style="{StaticResource AccentButtonStyle}" Click="Create_Click" AutomationProperties.Name="Create account">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8FA;" FontSize="14" /><TextBlock Text="Create account" /></StackPanel>
                        </Button>
                        <ProgressRing x:Name="CreateBusy" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                    <InfoBar x:Name="ServerNote" IsOpen="False" IsClosable="False" Severity="Informational" Title="Your Docket server isn't on this PC" />
                    <InfoBar x:Name="CreateResult" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <!-- People -->
            <Grid>
                <TextBlock Text="People" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="PeopleCount" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <ProgressRing x:Name="Spinner" IsActive="True" HorizontalAlignment="Left" />
            <VariableSizedWrapGrid x:Name="PeopleGrid" Orientation="Horizontal" ItemWidth="320" ItemHeight="84" />

            <!-- Teams -->
            <Grid Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Teams" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Share a list with a whole team at once." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="NewTeam_Click" AutomationProperties.Name="New team">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="New team" /></StackPanel>
                </Button>
            </Grid>
            <StackPanel x:Name="TeamsPanel" Spacing="8" />
        </StackPanel>
    </ScrollViewer>
</Page>
