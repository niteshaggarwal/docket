<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Docket.App.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:Docket.App.Controls">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="Scroller">
            <StackPanel x:Name="Body" Padding="32,20,32,32" Spacing="16" MaxWidth="1240">
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="Greeting" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="DateText" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)" AutomationProperties.Name="Refresh">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
                    </Button>
                </Grid>
                <ProgressRing x:Name="Spinner" IsActive="True" HorizontalAlignment="Center" Margin="0,48,0,0" />
                <StackPanel x:Name="Sections" Spacing="16" />
            </StackPanel>
        </ScrollViewer>

        <ctl:DetailPane x:Name="Detail" Grid.Column="1" Visibility="Collapsed" Closed="Detail_Closed" Changed="Detail_Changed" OpenTask="Detail_OpenTask" />
    </Grid>
</Page>
