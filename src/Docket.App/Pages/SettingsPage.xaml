<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Docket.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,16" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,20,32,40" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock Text="General" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource Section}">
                <StackPanel Spacing="14">
                    <ToggleSwitch x:Name="ConfirmDeleteSwitch" Header="Confirm before deleting" Toggled="General_Changed" />
                    <ComboBox x:Name="DefaultProject" Header="New tasks from smart lists go to" DisplayMemberPath="Title" MinWidth="260" SelectionChanged="DefaultProject_SelectionChanged" />
                    <RadioButtons x:Name="ThemeChoice" Header="Theme" SelectionChanged="Theme_Changed" MaxColumns="3">
                        <x:String>System</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </RadioButtons>
                </StackPanel>
            </Border>

            <TextBlock Text="Docket Pro" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource Section}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Note}" Text="Docket stays free. Docket Pro adds hosted extras that cost money to run: AI planning with no key, cloud backups, a calendar feed and email-to-task. Billing is handled by Dodo Payments." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="ProUrlBox" Header="Docket Cloud address" PlaceholderText="https://cloud.example.com" Width="380" LostFocus="ProUrl_LostFocus" />
                        <Button Content="Check" VerticalAlignment="Bottom" Click="ProRefresh_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ProStatusText" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <StackPanel x:Name="ProBuyPanel" Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ProPlanBox" Header="Plan" SelectedIndex="0" MinWidth="140">
                            <x:String>Pro</x:String>
                            <x:String>Family</x:String>
                            <x:String>Team</x:String>
                        </ComboBox>
                        <ComboBox x:Name="ProIntervalBox" Header="Billing" SelectedIndex="1" MinWidth="140">
                            <x:String>Monthly</x:String>
                            <x:String>Yearly</x:String>
                        </ComboBox>
                        <NumberBox x:Name="ProSeatsBox" Header="Seats (Team)" Value="2" Minimum="1" Maximum="500" SpinButtonPlacementMode="Compact" Width="120" />
                        <Button x:Name="ProSubscribeButton" Content="Subscribe" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="ProSubscribe_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ProBillingButton" Content="Manage billing" Click="ProBilling_Click" />
                        <TextBox x:Name="ProKeyBox" PlaceholderText="Paste a licence key" Width="280" />
                        <Button Content="Activate" Click="ProActivate_Click" />
                    </StackPanel>
                    <InfoBar x:Name="ProMessage" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <TextBlock Text="AI" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource Section}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource Note}">
                        Turn on the sparkle in the add bar (or type /ai) and describe what you need; the AI plans the tasks and subtasks and you choose which to add.
                        Local AI runs on this PC and nothing leaves it. Claude, ChatGPT and Gemini send your text to that company.
                    </TextBlock>
                    <RadioButtons x:Name="ProviderChoice" Header="Provider" MaxColumns="3" SelectionChanged="Provider_Changed">
                        <x:String>Local (Ollama)</x:String>
                        <x:String>Claude</x:String>
                        <x:String>ChatGPT</x:String>
                        <x:String>Gemini</x:String>
                        <x:String>Docket Cloud (Pro)</x:String>
                        <x:String>Off</x:String>
                    </RadioButtons>

                    <!-- Local -->
                    <StackPanel x:Name="LocalPanel" Spacing="12">
                        <Grid x:Name="OllamaStatus" ColumnSpacing="12" Padding="12" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="OllamaIcon" Glyph="&#xE895;" FontSize="16" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="OllamaTitle" Text="Checking local AI…" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="OllamaSub" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="InstallButton" Content="Install Ollama" Visibility="Collapsed" Click="Install_Click" />
                                <Button x:Name="CheckButton" Content="Check again" Click="Check_Click" />
                            </StackPanel>
                        </Grid>
                        <ComboBox x:Name="LocalModelBox" Header="Model" MinWidth="300" IsEditable="True" SelectionChanged="LocalModel_Changed" TextSubmitted="LocalModel_TextSubmitted"
                                  PlaceholderText="Choose an installed model" />
                        <StackPanel x:Name="DownloadPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Note}" Text="No chat model is installed yet. Download one to use local AI (several GB; it stays on this PC)." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="PullBox" Width="220" Text="qwen2.5:7b" AutomationProperties.Name="Model to download" />
                                <Button x:Name="PullButton" Content="Download model" Click="Pull_Click" />
                            </StackPanel>
                            <ProgressBar x:Name="PullProgress" Visibility="Collapsed" Maximum="1" Width="420" HorizontalAlignment="Left" />
                            <TextBlock x:Name="PullText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Docket Cloud (Pro) -->
                    <StackPanel x:Name="DocketCloudPanel" Spacing="8" Visibility="Collapsed">
                        <TextBox x:Name="CloudUrlBox" Header="Docket Cloud address" PlaceholderText="https://cloud.example.com" Width="380" HorizontalAlignment="Left" LostFocus="CloudUrl_LostFocus" />
                        <TextBlock Style="{StaticResource Note}" Text="With Docket Pro, planning runs on Docket Cloud with no key to set up. Each plan uses one of your monthly AI credits." />
                    </StackPanel>

                    <!-- Online -->
                    <StackPanel x:Name="CloudPanel" Spacing="12" Visibility="Collapsed">
                        <TextBox x:Name="CloudModelBox" Header="Model" Width="300" HorizontalAlignment="Left" LostFocus="CloudModel_LostFocus" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox x:Name="KeyBox" Header="API key" Width="380" />
                            <Button x:Name="SaveKeyButton" Content="Save key" VerticalAlignment="Bottom" Click="SaveKey_Click" />
                        </StackPanel>
                        <TextBlock x:Name="KeyNote" Style="{StaticResource Note}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TestButton" Click="Test_Click" AutomationProperties.Name="Test the AI">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="14" Height="14"><Path Fill="{ThemeResource AccentTextFillColorPrimaryBrush}" Data="M12,1 C12.7,7.2 16.8,11.3 23,12 C16.8,12.7 12.7,16.8 12,23 C11.3,16.8 7.2,12.7 1,12 C7.2,11.3 11.3,7.2 12,1 Z" /></Viewbox>
                                <TextBlock Text="Test: plan &quot;Buy milk tomorrow&quot;" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelTestButton" Content="Cancel" Visibility="Collapsed" Click="CancelTest_Click" />
                        <ProgressRing x:Name="TestBusy" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                    <InfoBar x:Name="TestResult" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <TextBlock Text="Smart lists" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource Section}">
                <StackPanel Spacing="6">
                    <ToggleSwitch x:Name="ShowImportantSwitch" Header="Important" Toggled="General_Changed" />
                    <ToggleSwitch x:Name="ShowPlannedSwitch" Header="Planned" Toggled="General_Changed" />
                    <ToggleSwitch x:Name="ShowAllSwitch" Header="All" Toggled="General_Changed" />
                    <ToggleSwitch x:Name="ShowCompletedSwitch" Header="Completed" Toggled="General_Changed" />
                    <ToggleSwitch x:Name="HideEmptySwitch" Header="Hide empty smart lists automatically" Toggled="General_Changed" />
                </StackPanel>
            </Border>

            <TextBlock Text="Reminders" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource Section}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource Note}">
                        Reminder pop-ups come from the docket notifier, which runs in the background so they arrive even when this window is closed.
                        Start it with "docket notify --watch", or ask Claude to set it to start with Windows.
                    </TextBlock>
                    <ToggleSwitch x:Name="SoundSwitch" Header="Play a sound with reminders" Toggled="General_Changed" />
                </StackPanel>
            </Border>

            <TextBlock Text="Connection" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource Section}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource Note}">
                        Docket talks to your Docket server. The setup script fills this in; you can also paste an API token from the server's web app (Settings, API Tokens).
                        Tokens are encrypted for your Windows account and stay on this PC.
                    </TextBlock>
                    <TextBox x:Name="ServerBox" Header="Server address" PlaceholderText="http://localhost:3456" />
                    <PasswordBox x:Name="TokenBox" Header="API token" PlaceholderText="tk_..." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SaveButton" Content="Test and save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                        <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                    <InfoBar x:Name="Result" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource Heading}" />
            <Border Style="{StaticResource Section}">
                <TextBlock Style="{StaticResource Note}" IsTextSelectionEnabled="True">
                    Ctrl+N add a task · Ctrl+D complete · Ctrl+T add to or remove from My Day · Ctrl+I important · Delete delete · Enter open details · Esc close details ·
                    Right/Left expand or collapse subtasks · Ctrl+F search · Ctrl+L new list · Ctrl+R or F5 refresh.
                    In the add bar, "today", "tomorrow", a weekday, "in 3 days" or 20/11 sets the due date, and !1 to !5 the priority.
                    Type / for commands: /s search, /x mark the matches done, /m add them to My Day, /i star them, /ai plan with AI.
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
