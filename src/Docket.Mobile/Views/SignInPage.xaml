<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Docket.Mobile.Views.SignInPage"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,56,24,24" Spacing="14" MaximumWidthRequest="480">
            <Image Source="docket_mark.png" WidthRequest="72" HeightRequest="72" HorizontalOptions="Start" />
            <Label Text="Welcome to Docket" Style="{StaticResource Title}" />
            <Label Text="Sign in to your Docket server. Docket keeps a sign-in key for this phone; your password isn't stored." Style="{StaticResource Caption}" FontSize="14" />

            <Label Text="Server address" Style="{StaticResource BodyStrong}" Margin="0,10,0,0" />
            <Border Style="{StaticResource FieldBox}">
                <Entry x:Name="ServerBox" Placeholder="e.g. tasks.example.com or my-pc.tail1234.ts.net" Keyboard="Url" />
            </Border>
            <Label Text="Username" Style="{StaticResource BodyStrong}" />
            <Border Style="{StaticResource FieldBox}">
                <Entry x:Name="UserBox" Placeholder="Username" Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
            </Border>
            <Label Text="Password" Style="{StaticResource BodyStrong}" />
            <Border Style="{StaticResource FieldBox}">
                <Entry x:Name="PassBox" Placeholder="Password" IsPassword="True" />
            </Border>
            <Label Text="Two-factor code (if you use one)" Style="{StaticResource BodyStrong}" />
            <Border Style="{StaticResource FieldBox}">
                <Entry x:Name="TotpBox" Placeholder="123456" Keyboard="Numeric" />
            </Border>

            <Label x:Name="ErrorText" IsVisible="False" TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,6,0,0">
                <Button x:Name="SignInButton" Text="Sign in" Style="{StaticResource Accent}" Clicked="SignIn_Clicked" />
                <ActivityIndicator x:Name="Busy" Grid.Column="1" IsRunning="False" HorizontalOptions="Start" WidthRequest="24" HeightRequest="24" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
