<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Docket.Mobile.ViewModels"
             xmlns:v="clr-namespace:Docket.Mobile.Views"
             x:Class="Docket.Mobile.Views.ListPage"
             x:DataType="vm:ListViewModel"
             Shell.NavBarIsVisible="False"
             Title="">

    <ContentPage.Resources>
        <DataTemplate x:Key="HeaderRow" x:DataType="vm:GroupHeaderRow">
            <HorizontalStackLayout Spacing="8" Padding="16,16,16,4">
                <Label Text="{Binding Title}" Style="{StaticResource BodyStrong}" TextColor="{Binding OnImage, Converter={StaticResource OnImageText}}" />
                <Label Text="{Binding Count}" Style="{StaticResource Caption}" VerticalTextAlignment="Center" TextColor="{Binding OnImage, Converter={StaticResource OnImageText2}}" />
            </HorizontalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="TaskTemplate" x:DataType="vm:TaskRow">
            <SwipeView Margin="{Binding RowMargin}">
                <SwipeView.LeftItems>
                    <SwipeItems Mode="Execute">
                        <SwipeItem Text="My Day" BackgroundColor="#C27C0E"
                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListViewModel}}, Path=ToggleMyDayCommand, x:DataType=vm:ListViewModel}" CommandParameter="{Binding .}" />
                    </SwipeItems>
                </SwipeView.LeftItems>
                <SwipeView.RightItems>
                    <SwipeItems Mode="Execute">
                        <SwipeItem Text="Delete" BackgroundColor="#C42B1C"
                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListViewModel}}, Path=DeleteCommand, x:DataType=vm:ListViewModel}" CommandParameter="{Binding .}" />
                    </SwipeItems>
                </SwipeView.RightItems>
                <Border Style="{StaticResource Card}" Padding="4,6,4,6">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListViewModel}}, Path=OpenCommand, x:DataType=vm:ListViewModel}" CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,44,*,44">
                        <ContentView WidthRequest="{Binding ChevronWidth}" VerticalOptions="Fill">
                            <ContentView.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListViewModel}}, Path=ToggleExpandCommand, x:DataType=vm:ListViewModel}" CommandParameter="{Binding .}" />
                            </ContentView.GestureRecognizers>
                            <Label Style="{StaticResource Icon}" Text="{StaticResource IcChevron}" FontSize="14" IsVisible="{Binding HasChildren}" Rotation="{Binding ChevronRotation}"
                                   SemanticProperties.Description="Show subtasks" HorizontalOptions="End" />
                        </ContentView>
                        <v:FluentCheck Grid.Column="1" IsChecked="{Binding IsDone}" HorizontalOptions="Center" VerticalOptions="Center"
                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListViewModel}}, Path=ToggleDoneCommand, x:DataType=vm:ListViewModel}" CommandParameter="{Binding .}" />
                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center" Padding="0,4">
                            <Label Text="{Binding Title}" Opacity="{Binding TitleOpacity}" TextDecorations="{Binding TitleDecorations}" LineBreakMode="WordWrap" />
                            <FlexLayout Wrap="Wrap" AlignItems="Center" IsVisible="{Binding HasMeta}" Margin="0,0,0,2">
                                <HorizontalStackLayout Spacing="3" IsVisible="{Binding InMyDay}" Margin="0,0,10,0">
                                    <Label Style="{StaticResource Icon}" Text="{StaticResource IcSun}" FontSize="12" Opacity="0.7" />
                                    <Label Text="My Day" Style="{StaticResource Caption}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Project}" IsVisible="{Binding ShowList}" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                                <HorizontalStackLayout Spacing="3" IsVisible="{Binding HasSubtasks}" Margin="0,0,10,0">
                                    <Label Style="{StaticResource Icon}" Text="{StaticResource IcTree}" FontSize="12" Opacity="0.7" />
                                    <Label Text="{Binding SubtaskText}" Style="{StaticResource Caption}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding StepsText}" IsVisible="{Binding HasSteps}" Style="{StaticResource Caption}" Margin="0,0,10,0" />
                                <HorizontalStackLayout Spacing="3" IsVisible="{Binding HasDue}" Margin="0,0,10,0">
                                    <Label Style="{StaticResource Icon}" Text="{StaticResource IcCalendar}" FontSize="12"
                                           TextColor="{Binding IsOverdue, Converter={StaticResource OverdueColor}}" />
                                    <Label Text="{Binding DueText}" Style="{StaticResource Caption}" TextColor="{Binding IsOverdue, Converter={StaticResource OverdueColor}}" />
                                </HorizontalStackLayout>
                                <Label Style="{StaticResource Icon}" Text="{StaticResource IcBell}" FontSize="12" Opacity="0.7" IsVisible="{Binding HasReminder}" Margin="0,0,8,0" />
                                <Label Style="{StaticResource Icon}" Text="{StaticResource IcRepeat}" FontSize="12" Opacity="0.7" IsVisible="{Binding HasRepeat}" Margin="0,0,8,0" />
                                <Label Style="{StaticResource Icon}" Text="{StaticResource IcNote}" FontSize="12" Opacity="0.7" IsVisible="{Binding HasNotes}" Margin="0,0,8,0" />
                                <Label Style="{StaticResource Icon}" Text="{StaticResource IcAttach}" FontSize="12" Opacity="0.7" IsVisible="{Binding HasFiles}" Margin="0,0,8,0" />
                                <Border IsVisible="{Binding HasPriority}" StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="5,0" Margin="0,1,8,1" BackgroundColor="{Binding PriorityTint}">
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Style="{StaticResource Icon}" Text="{StaticResource IcFlag}" FontSize="11" TextColor="{Binding PriorityColor}" />
                                        <Label Text="{Binding PriorityText}" Style="{StaticResource Caption}" FontFamily="SelawikSemibold" TextColor="{Binding PriorityColor}" />
                                    </HorizontalStackLayout>
                                </Border>
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Chips}" IsVisible="{Binding HasChips}" Spacing="6" Margin="0,0,8,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ChipVm">
                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="6,0" BackgroundColor="{Binding Color, Converter={StaticResource Tint}}">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Ellipse WidthRequest="6" HeightRequest="6" Fill="{Binding Color}" VerticalOptions="Center" />
                                                    <Label Text="{Binding Text}" Style="{StaticResource Caption}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout IsVisible="{Binding HasAssignees}" Spacing="-4">
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Avatars}" Spacing="-4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AvatarVm">
                                                <Border WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10" StrokeThickness="1.5" Padding="0" BackgroundColor="{Binding Color}"
                                                        Stroke="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}" SemanticProperties.Description="{Binding Name}">
                                                    <Label Text="{Binding Initials}" FontSize="8" FontFamily="SelawikSemibold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding MoreAssignees}" Style="{StaticResource Caption}" Margin="6,0,0,0" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Text="{Binding StarGlyph}" FontFamily="{Binding StarFont}"
                                TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListViewModel}}, Path=ToggleStarCommand, x:DataType=vm:ListViewModel}" CommandParameter="{Binding .}"
                                SemanticProperties.Description="Mark as important" />
                    </Grid>
                </Border>
            </SwipeView>
        </DataTemplate>

        <v:RowSelector x:Key="RowSelector" Header="{StaticResource HeaderRow}" Task="{StaticResource TaskTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- The list's background: a colour, gradient or picture, with a scrim so text stays readable -->
        <BoxView Grid.RowSpan="3" Background="{Binding BackgroundBrush}" IsVisible="{Binding HasBackground}" />
        <Image Grid.RowSpan="3" Source="{Binding BackgroundImage}" Aspect="AspectFill" IsVisible="{Binding BackgroundImage, Converter={StaticResource IsNotNullConverter}}" />
        <BoxView Grid.RowSpan="3" IsVisible="{Binding HasBackground}" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#8C000000" Offset="0" />
                    <GradientStop Color="#33000000" Offset="0.3" />
                    <GradientStop Color="#26000000" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Header -->
        <VerticalStackLayout Padding="4,4,4,6" Spacing="2">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button Style="{StaticResource IconButton}" Text="{StaticResource IcBack}" Command="{Binding BackCommand}" TextColor="{Binding HeaderColor}" SemanticProperties.Description="Back" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Text="{StaticResource IcBulb}" Command="{Binding SuggestionsCommand}" IsVisible="{Binding IsMyDay}" TextColor="{Binding HeaderColor}" SemanticProperties.Description="Suggestions" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Text="{StaticResource IcMore}" Command="{Binding MoreCommand}" TextColor="{Binding HeaderColor}" SemanticProperties.Description="List options" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" Padding="12,0,12,0" ColumnSpacing="10">
                <Label Style="{StaticResource AccentIcon}" Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="{Binding GlyphSize}" TextColor="{Binding IconColor}" />
                <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Title}" TextColor="{Binding HeaderColor}" LineBreakMode="TailTruncation" />
            </Grid>
            <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="14" Margin="16,0" TextColor="{Binding HeaderColor2}" IsVisible="{Binding Subtitle, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="12,8,0,0">
                <HorizontalStackLayout x:Name="Pills" Spacing="8" />
            </ScrollView>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}" IsVisible="{Binding IsListView}">
            <CollectionView ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowSelector}" SelectionMode="None">
                <CollectionView.Header>
                    <Label Text="{Binding Error}" IsVisible="{Binding Error, Converter={StaticResource IsNotNullConverter}}" Margin="16,0,16,8"
                           TextColor="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                </CollectionView.Header>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32,48" Spacing="10" IsVisible="{Binding IsEmpty}">
                        <Label Style="{StaticResource Icon}" Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="44" Opacity="0.35" TextColor="{Binding HeaderColor}" />
                        <Label Text="{Binding EmptyText}" HorizontalTextAlignment="Center" Opacity="0.75" TextColor="{Binding HeaderColor}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,8,0,24" IsVisible="{Binding ShowDone}">
                        <Grid ColumnDefinitions="Auto,*" Padding="16,8" HeightRequest="44">
                            <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleDoneSectionCommand}" /></Grid.GestureRecognizers>
                            <Label Style="{StaticResource Icon}" Text="{StaticResource IcChevron}" FontSize="14" TextColor="{Binding HeaderColor}" Rotation="{Binding DoneExpanded, Converter={StaticResource ChevronRotation}}" />
                            <Label Grid.Column="1" Text="{Binding DoneHeader}" Style="{StaticResource BodyStrong}" TextColor="{Binding HeaderColor}" Margin="8,0,0,0" VerticalTextAlignment="Center" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding DoneExpanded}" BindableLayout.ItemsSource="{Binding Done}" BindableLayout.ItemTemplate="{StaticResource TaskTemplate}" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Table, Timeline and Board are drawn in code -->
        <ContentView x:Name="AltHost" Grid.Row="1" IsVisible="{Binding IsOtherView}" />
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsOtherView}" HorizontalOptions="Center" VerticalOptions="Start" WidthRequest="24" HeightRequest="24" Margin="0,8" />

        <!-- Slash commands, shown while typing "/" -->
        <Border Grid.Row="1" IsVisible="{Binding ShowSlash}" Style="{StaticResource Card}" Margin="12,0,12,4" Padding="4" VerticalOptions="End">
            <Border.Shadow><Shadow Brush="Black" Opacity="0.18" Radius="16" Offset="0,4" /></Border.Shadow>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SlashItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlashItem">
                        <Grid ColumnDefinitions="56,*" HeightRequest="44" Padding="8,0">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListViewModel}}, Path=PickSlashCommand, x:DataType=vm:ListViewModel}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Command}" FontFamily="SelawikSemibold" VerticalTextAlignment="Center" TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                            <Label Grid.Column="1" Text="{Binding Help}" Style="{StaticResource Caption}" FontSize="14" VerticalTextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>

        <!-- Add bar -->
        <Border Grid.Row="2" IsVisible="{Binding CanAdd}" Style="{StaticResource Card}" Margin="12,6,12,12" Padding="2,2">
            <Border.Shadow><Shadow Brush="Black" Opacity="0.08" Radius="10" Offset="0,2" /></Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Style="{StaticResource IconButton}" Text="{StaticResource IcSparkle}" FontFamily="{Binding AiFont}" TextColor="{Binding AiColor}" Command="{Binding ToggleAiCommand}" SemanticProperties.Description="Plan with AI" />
                <Entry x:Name="AddEntry" Grid.Column="1" Placeholder="{Binding AddPlaceholder}" Text="{Binding NewTask}" ReturnType="Done" ReturnCommand="{Binding AddCommand}" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Text="{StaticResource IcSend}" Command="{Binding AddCommand}"
                        TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" SemanticProperties.Description="Add task" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
