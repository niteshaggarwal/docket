<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Docket.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <ApplicationTitle>Docket</ApplicationTitle>
    <ApplicationId>com.quartifex.docket</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

    <!-- Generated MAUI code is not ours to fix; keep warnings visible but not fatal here. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);XC0022;XC0025</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- AAB for Google Play, APK for direct download (GitHub releases). -->
    <AndroidPackageFormats>aab;apk</AndroidPackageFormats>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#F2683F" ForegroundScale="0.62" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#F2683F" BaseSize="160,160" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Plugin.LocalNotification" Version="14.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Docket.Core\Docket.Core.csproj" />
  </ItemGroup>

</Project>
