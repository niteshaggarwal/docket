# One HTTPS address for everything. Caddy gets and renews the certificate automatically
# (the domain must point at this server, with ports 80 and 443 open).
{$DOCKET_DOMAIN} {
	encode zstd gzip

	# The Docket AI connector: MCP, OAuth sign-in for AI apps, REST + OpenAPI for GPT actions.
	@connector path /mcp /mcp/* /oauth/* /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server* /api/tools/* /openapi.json
	handle @connector {
		reverse_proxy connector:8080 {
			# MCP replies can stream; don't buffer them.
			flush_interval -1
		}
	}
	handle /connector/health {
		rewrite * /health
		reverse_proxy connector:8080
	}

	# Everything else: Vikunja's web app (in the Docket skin, through docket-web) and its API; the Docket apps sign
	# in here. docket-web passes the API, WebSocket, uploads and share links straight through. If it is down or
	# missing (an older connector image), requests go to Vikunja directly, so the site keeps working.
	handle {
		reverse_proxy web:8080 vikunja:3456 {
			lb_policy first
			lb_try_duration 3s
			fail_duration 30s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
