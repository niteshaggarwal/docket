# Copy to .env and fill in (setup.sh does this for you). Never commit .env.

# Public address of this server. Point its DNS A/AAAA record here and open ports 80 and 443.
DOCKET_DOMAIN=tasks.example.com

# Your time zone (IANA name), used for due dates and reminders.
TZ=Europe/London

# Secret for Vikunja's sign-in tokens. Make one with: openssl rand -hex 32
VIKUNJA_SECRET=

# The connector key: AI apps use it as a Bearer token, or type it once on the OAuth sign-in page.
# 24+ characters. Make one with: openssl rand -hex 32
DOCKET_MCP_KEY=

# true while you create your account; then set to false and run: docker compose up -d
VIKUNJA_REGISTRATION=true

# Optional
# DOCKET_DEFAULT_LIST=        # list id that new tasks go to when no list is given
# DOCKET_VERSION=latest       # connector image tag, e.g. 0.3.0
# VIKUNJA_VERSION=2.7.1
# HTTP_PORT=80
# HTTPS_PORT=443
